    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
