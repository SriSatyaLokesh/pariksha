{
  "name": "pariksha",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm tokens && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 && pnpm vitest run scripts",
    "test:changed": "vitest run --changed",
    "test:pkg": "turbo run test --filter",
    "tokens": "node scripts/tokens.mjs",
    "deploy:cf": "pnpm --filter @pariksha/api exec wrangler deploy -c ../../deploy/cloudflare/wrangler.toml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
