# Pariksha Docker Self-Host Environment Configuration (S-01, S-02, AC-01)
# Copy this file to .env and adjust values before running `docker compose up -d`.

# Public domain and URL (required for cookies, CORS, and short links)
DOMAIN=pariksha.example.com
PUBLIC_URL=https://pariksha.example.com
ACME_EMAIL=admin@example.com

# Session secret (required: generate with `openssl rand -hex 32`)
SESSION_SECRET=replace_with_a_secure_random_hex_string_at_least_32_chars

# Database Configuration (Postgres 16)
# Only needed when using docker-compose.yml. If using SQLite, ignore these.
POSTGRES_USER=pariksha
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=pariksha

# Object Storage Configuration (MinIO / S3)
# Only needed when using docker-compose.yml. If using SQLite, local disk is used automatically.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_secure_minio_password
S3_BUCKET=pariksha

# Transactional Email (Optional)
# If left empty, first run owner creation works via Email + Password.
# In development, you can set EMAIL_CONSOLE=true to log magic links/codes to stdout.
EMAIL_ENDPOINT=
EMAIL_TOKEN=
EMAIL_FROM=notifications@example.com
EMAIL_CONSOLE=
